# ═══════════════════════════════════════════════════════════════════════
# GreenOps Refactor - Environment Configuration
# ═══════════════════════════════════════════════════════════════════════
#
# QUICK START:
# 1. Copy this file to .env:       cp .env.example .env
# 2. Fill in HOME_ASSISTANT_TOKEN: Get from Settings → Developer Tools
# 3. Run with Docker:               docker-compose -f docker-compose.prod.yml up -d
#
# ═══════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────
# HOME ASSISTANT CONFIGURATION (REQUIRED)
# ───────────────────────────────────────────────────────────────────────
# Your Home Assistant URL:
#
# • Docker Desktop (Windows/Mac): http://host.docker.internal:8123
# • Linux / Standalone Docker:    http://YOUR_IP_ADDRESS:8123  (e.g., 192.168.1.50:8123)
# • Hostname:                      http://homeassistant.local:8123
# • Docker network:                http://homeassistant:8123
#
HOME_ASSISTANT_URL=http://host.docker.internal:8123

# Generate Long-Lived Token in Home Assistant:
# 1. Go to Settings (⚙️ bottom left)
# 2. Developer Tools → Personal access tokens
# 3. Click "Create token" and name it "GreenOps"
# 4. Copy the full token (shown only once!)
# 5. Paste it below:
#
HOME_ASSISTANT_TOKEN=

# Optional: CO₂ intensity sensor entity ID (gCO₂eq/kWh)
# Example: sensor.grid_co2_intensity
HOME_ASSISTANT_CO2_SENSOR=sensor.carbon_intensity

# Optional: Fossil fuel percentage sensor entity ID (percent, 0-100)
# Example: sensor.grid_fossil_fuel_percentage
HOME_ASSISTANT_FOSSIL_SENSOR=sensor.fossil_fuel_percentage

# Optional: Display label for the grid (shown in UI)
# GREENOPS_GRID_LABEL=My Local Grid

# ───────────────────────────────────────────────────────────────────────
# ELECTRICITY MAPS API (FALLBACK - Optional)
# ───────────────────────────────────────────────────────────────────────
# Only used if Home Assistant sensors are unavailable
# Get free API key: https://electricitymaps.com/
# ELECTRICITY_MAPS_API_KEY=
# ELECTRICITY_MAPS_ZONE=IN-WE

# ───────────────────────────────────────────────────────────────────────
# OLLAMA LLM CONFIGURATION (Optional)
# ───────────────────────────────────────────────────────────────────────
# Ollama URL:
#
# • Docker Desktop (Windows/Mac): http://host.docker.internal:11434
# • Linux / Standalone:           http://localhost:11434
# • Docker compose/network:       http://greenops-ollama:11434
#
OLLAMA_BASE_URL=http://host.docker.internal:11434

# LLM model to use (runs inside Docker, auto-downloaded on first use)
OLLAMA_MODEL=qwen2.5-coder:1.5b

# Average power consumption of Ollama inference (watts)
# Measure with: plug meter, HWiNFO, Intel XTU, etc.
# Leave blank to show time-only estimates (no power estimate)
# GREENOPS_OLLAMA_AVG_POWER_WATTS=50

# ───────────────────────────────────────────────────────────────────────
# FLASK APPLICATION CONFIGURATION
# ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-string
DEBUG=false
LOG_LEVEL=INFO
